// use prisma-8

// use prisma-8

enum UserRole {
  DRIVER
  PASSENGER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}
